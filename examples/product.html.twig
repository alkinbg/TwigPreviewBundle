{# Copy to templates/previews/product.html.twig in your Symfony application. #}
{% extends 'base.html.twig' %}
{% block body %}
    <main class="container">
        <h1>{{ product.name }}</h1>
        <p>Price: {{ product.price|format_currency('EUR') }}</p>
        <p>{{ product.available ? 'In stock' : 'Out of stock' }}</p>
    </main>
{% endblock %}
